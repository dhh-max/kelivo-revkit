# SoLab 只维护 Android，忽略上游带入的其它平台脚手架
/ios/
/linux/
/macos/
/windows/

# 本机同步进来的原生资产（jniLibs 195MB / assets 15MB / libs jar）：上游同样不入库，
# 由 tools/sync_from_kelivo.ps1 单向同步，属于构建产物而非源码。
/android/app/src/main/jniLibs/
/android/app/src/main/assets/
/android/app/src/main/libs/
/android/bootstrap-demo/

# Local iOS profiling tools and device measurements
/docs/performance/ios-device-*/
/tool/ios_performance/

# Gradle 工程级构建输出（android/build、android/app/build）
/android/build/
/android/.gradle/

# 同步/复测临时物与构建中间件（2026-09-24 清理）
_inspect_tmp/
__pycache__/
*.pyc
android/.cxx/
android/app/.cxx/
*.log

# 本机环境适配：cargo 直连（覆盖 git 全局里指向本机代理的 http.proxy）。
# 代理不可用时 cargo 会卡在依赖下载，构建脚本无法完成。
.cargo/
_tmp/
